<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>SupplyRun</AssemblyName>
    <RootNamespace>SupplyRun</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\</OutputPath>
    <GamePath>C:\Program Files (x86)\Steam\steamapps\common\Schedule I</GamePath>
    <NoWarn>$(NoWarn);CS0618;MSB3277;CS1701;CS1702</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Logic\Core.cs" Link="Logic\Core.cs" />
    <Compile Include="..\Logic\State.cs" Link="Logic\State.cs" />
    <Compile Include="..\Logic\Courier.cs" Link="Logic\Courier.cs" />
    <Compile Include="..\Logic\Patches.cs" Link="Logic\Patches.cs" />
    <Compile Include="..\Logic\FixerUnlock.cs" Link="Logic\FixerUnlock.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(GamePath)\MelonLoader\net6\MelonLoader.dll"><Private>false</Private></Reference>
    <Reference Include="$(GamePath)\MelonLoader\net6\0Harmony.dll"><Private>false</Private></Reference>
    <Reference Include="$(GamePath)\MelonLoader\net6\Il2CppInterop.Runtime.dll"><Private>false</Private></Reference>
    <Reference Include="$(GamePath)\MelonLoader\net6\Il2CppInterop.Common.dll"><Private>false</Private></Reference>
    <Reference Include="$(GamePath)\MelonLoader\Il2CppAssemblies\*.dll"><Private>false</Private></Reference>
  </ItemGroup>

</Project>
